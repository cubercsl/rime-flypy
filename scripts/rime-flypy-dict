### Decompile the upstream Flypy main table into the repository's primary dictionary.
### Requires rime_table_decompiler from librime >= 1.9.0.
###
### Usage: rime-flypy-dict --assets DIR --output DIR --version VERSION
###
### Options:
###   -h, --help             Show this help message and exit
###   -a, --assets DIR       Directory containing flypy.table.bin
###   -o, --output DIR       Repository output directory
###   -v, --version VERSION  Dictionary version

print_help() {
    sed -rn 's/^### ?//;T;p' "$0" >&2
}

script_dir=$(cd "$(dirname "${BASH_SOURCE[0]}")" &> /dev/null && pwd)
root_dir=$(dirname "$script_dir")
assets_dir=$root_dir/assets
output_dir=$root_dir
version=

options=$(getopt -o ha:o:v: -l help,assets:,output:,version: -n rime-flypy-dict -- "$@") || {
    print_help
    exit 1
}
eval set -- "$options"
while true; do
    case "$1" in
        -h|--help)
            print_help
            exit 0
            ;;
        -a|--assets)
            assets_dir=$2
            shift 2
            ;;
        -o|--output)
            output_dir=$2
            shift 2
            ;;
        -v|--version)
            version=$2
            shift 2
            ;;
        --)
            shift
            break
            ;;
    esac
done

if [[ $# -ne 0 || -z $version ]]; then
    print_help
    exit 1
fi

command -v rime_table_decompiler &> /dev/null || {
    echo "rime_table_decompiler not found" >&2
    exit 1
}

source_file=$assets_dir/flypy.table.bin
output_file=$output_dir/flypy/flypy.primary.dict.yaml

[[ -f $source_file ]] || {
    echo "File not found: $source_file" >&2
    exit 1
}

mkdir -p "$(dirname "$output_file")"
rime_table_decompiler "$source_file" "$output_file"
sed -i \
    -e "s/^name: .*/name: flypy.primary/" \
    -e "s/^version: .*/version: \"$version\"/" \
    "$output_file"
