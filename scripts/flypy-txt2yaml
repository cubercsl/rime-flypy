import argparse
from collections.abc import Iterable
from pathlib import Path


SYSTEM_SECTIONS = {
    "快符": "fast.symbols",
    "次选字词": "secondary",
    "三码填空": "three",
    "emoji表情": "emoji",
    "符号": "symbols",
    "微信表情": "wechat",
    "一简次选": "primary.short.word",
    "随心   自定编码规则，零星调节重码或别扭码": "whimsicality",
    "no comment": "symbols",
}

MODE_SECTIONS = {
    "二简次选：": "secondary.short.code",
    "1.全码词 置顶 本类词条放到 flypy_top.txt 文件": "full.top",
    "2.全码词 居后 本类词条放“flypy_user.txt”文件": "full",
}

REQUIRED_SYSTEM_SECTIONS = {
    "fast.symbols",
    "secondary",
    "three",
    "emoji",
    "symbols",
    "wechat",
    "primary.short.word",
    "whimsicality",
}

REQUIRED_MODE_SECTIONS = {
    "secondary.short.code",
    "full.top",
    "full",
}

DICTIONARY_COMMENTS = {
    "web": "网站",
    "fast.symbols": "快符",
    "secondary": "次选字词",
    "three": "三码填空",
    "emoji": "emoji表情",
    "symbols": "符号",
    "wechat": "微信表情",
    "primary.short.word": "一简次选",
    "whimsicality": "随心",
    "secondary.short.code": "二简次选",
    "full.top": "全码词 置顶",
    "full": "全码词 居后",
    "full.char": "全码字",
    "ok": "ok拼字",
}

# The upstream text omits U+FF07 from the fullwidth punctuation sequence.
# https://github.com/gaboolic/rime-shuangpin-fuzhuma/blob/08f0d24bd88a2f44210f97fb9d6f3dedc18ab794/md/fuhao.md#L44
SOURCE_CORRECTIONS = {
    ("flypy_sys.txt", "\tofbd\t69"): "＇\tofbd\t69",
}


def parse_entry(line: str, source: Path, line_number: int) -> str:
    fields = line.split("\t")
    if len(fields) < 2 or not fields[0] or not fields[1].strip():
        raise ValueError(f"{source}:{line_number}: invalid dictionary entry: {line!r}")
    return line


def parse_sectioned_file(
    source: Path,
    sections: dict[str, str],
    required_sections: set[str],
    initial_section: str | None = None,
) -> dict[str, list[str]]:
    dictionaries: dict[str, list[str]] = {}
    current_section = initial_section
    if current_section is not None:
        dictionaries[current_section] = []

    discovered_sections: set[str] = set()
    has_seen_section = False
    for line_number, raw_line in enumerate(source.read_text(encoding="utf-8").splitlines(), 1):
        raw_line = SOURCE_CORRECTIONS.get((source.name, raw_line), raw_line)
        if not raw_line.strip():
            continue

        if raw_line.startswith("#") and "\t" not in raw_line:
            heading = raw_line[1:].strip()
            if heading in sections:
                current_section = sections[heading]
                has_seen_section = True
                discovered_sections.add(current_section)
                dictionaries.setdefault(current_section, [])
            elif has_seen_section:
                current_section = None
            continue

        if current_section is None:
            raise ValueError(f"{source}:{line_number}: entry appears before a known section")
        dictionaries[current_section].append(parse_entry(raw_line, source, line_number))

    missing_sections = required_sections - discovered_sections
    if missing_sections:
        missing = ", ".join(sorted(missing_sections))
        raise ValueError(f"{source}: missing required sections: {missing}")
    return dictionaries


def parse_plain_dictionary(source: Path) -> list[str]:
    entries = []
    for line_number, raw_line in enumerate(source.read_text(encoding="utf-8").splitlines(), 1):
        if not raw_line.strip() or (raw_line.startswith("#") and "\t" not in raw_line):
            continue
        entries.append(parse_entry(raw_line, source, line_number))
    return entries


def parse_rime_dictionary(source: Path) -> list[str]:
    entries = []
    in_dictionary = False
    for line_number, raw_line in enumerate(source.read_text(encoding="utf-8").splitlines(), 1):
        if not in_dictionary:
            if raw_line == "...":
                in_dictionary = True
            continue
        if not raw_line or (raw_line.startswith("#") and "\t" not in raw_line):
            continue
        entries.append(parse_entry(raw_line, source, line_number))

    if not in_dictionary:
        raise ValueError(f"{source}: missing Rime dictionary marker")
    return entries


def normalize_reverse_lookup_dictionary(source: Path) -> list[str]:
    # Match the previous binary round trip: remove exact duplicates, then order by
    # code without disturbing candidate order among entries with the same code.
    entries = dict.fromkeys(parse_rime_dictionary(source))
    return sorted(entries, key=lambda entry: entry.split("\t", 2)[1])


def strip_code_prefix(entries: Iterable[str], prefix: str, source: Path) -> list[str]:
    stripped_entries = []
    for entry in entries:
        fields = entry.split("\t")
        code = fields[1]
        if not code.startswith(prefix) or len(code) == len(prefix):
            raise ValueError(f"{source}: dictionary code does not start with {prefix!r}: {entry!r}")
        fields[1] = code[len(prefix):]
        stripped_entries.append("\t".join(fields))
    return stripped_entries


def merge_dictionaries(
    dictionaries: dict[str, list[str]], additions: dict[str, list[str]]
) -> None:
    for name, entries in additions.items():
        dictionaries.setdefault(name, []).extend(entries)


def classify_system_preamble(dictionaries: dict[str, list[str]]) -> None:
    web_entries = []
    emoji_entries = []
    for entry in dictionaries["web"]:
        token, code, *_ = entry.split("\t")
        if token.startswith(("http://", "https://")):
            web_entries.append(entry)
        elif code in {"oi", "ok"}:
            emoji_entries.append(entry)
        else:
            raise ValueError(f"unrecognized flypy_sys.txt preamble entry: {entry!r}")

    dictionaries["web"] = web_entries
    dictionaries["emoji"] = emoji_entries + dictionaries["emoji"]


def classify_wechat_entries(dictionaries: dict[str, list[str]]) -> None:
    wechat_entries = []
    emoji_entries = []
    for entry in dictionaries["wechat"]:
        token, code, *_ = entry.split("\t")
        if token.startswith("[") and token.endswith("]"):
            wechat_entries.append(entry)
        elif code.startswith("oi"):
            emoji_entries.append(entry)
        else:
            raise ValueError(f"unrecognized WeChat entry: {entry!r}")

    dictionaries["wechat"] = wechat_entries
    dictionaries["emoji"].extend(emoji_entries)


def import_semicolon_symbols(source: Path, dictionaries: dict[str, list[str]]) -> None:
    entries = parse_plain_dictionary(source)
    expected_entries = ["：\t;", "；\t;"]
    if entries != expected_entries:
        raise ValueError(f"{source}: expected only the built-in colon and semicolon entries")
    dictionaries["fast.symbols"] = entries + dictionaries["fast.symbols"]


def write_dictionary(
    output_dir: Path,
    name: str,
    version: str,
    entries: Iterable[str],
    *,
    sort_original: bool = False,
) -> None:
    if name == "ok":
        output = output_dir / "flypyok.dict.yaml"
        dictionary_name = "flypyok"
    else:
        output = output_dir / "flypy" / f"flypy.{name}.dict.yaml"
        dictionary_name = f"flypy.{name}"
    body = list(entries)
    for index, entry in enumerate(body):
        if entry.startswith("#\t"):
            # This directive disables comment parsing for the remaining entries.
            # https://github.com/rime/librime/blob/417db2385f732cb0fa194b497042c42abb897d99/src/rime/dict/entry_collector.cc#L78-L95
            body.insert(index, "# no comment")
            break

    header = [
        f"# {DICTIONARY_COMMENTS[name]}",
        "---",
        f"name: {dictionary_name}",
        f'version: "{version}"',
    ]
    if sort_original:
        header.append("sort: original")
    header.extend(("use_preset_vocabulary: false", "..."))
    content = "\n".join((*header, *body, ""))
    output.write_text(content, encoding="utf-8")


def write_reverse_lookup_dictionary(
    output_dir: Path, version: str, entries: Iterable[str]
) -> None:
    content = "\n".join(
        (
            "# Rime dictionary",
            "",
            "---",
            "name: flypydz",
            f'version: "{version}"',
            "...",
            "",
            *entries,
            "",
        )
    )
    (output_dir / "flypydz.dict.yaml").write_text(content, encoding="utf-8")


def convert(source_dir: Path, output_dir: Path, version: str) -> None:
    dictionaries = parse_sectioned_file(
        source_dir / "flypy_sys.txt",
        SYSTEM_SECTIONS,
        REQUIRED_SYSTEM_SECTIONS,
        initial_section="web",
    )
    classify_system_preamble(dictionaries)
    classify_wechat_entries(dictionaries)
    import_semicolon_symbols(source_dir / "flypy_top.txt", dictionaries)
    merge_dictionaries(
        dictionaries,
        parse_sectioned_file(
            source_dir / "模式切换&补充简码方案.txt",
            MODE_SECTIONS,
            REQUIRED_MODE_SECTIONS,
        ),
    )
    dictionaries["full.char"] = parse_plain_dictionary(source_dir / "flypy_full全码字.txt")
    ok_source = source_dir / "flypy_ok.txt"
    dictionaries["ok"] = strip_code_prefix(
        parse_rime_dictionary(ok_source), "ok", ok_source
    )
    reverse_lookup_entries = normalize_reverse_lookup_dictionary(
        source_dir / "flypydz.dict.yaml"
    )

    (output_dir / "flypy").mkdir(parents=True, exist_ok=True)
    for name, entries in dictionaries.items():
        write_dictionary(output_dir, name, version, entries, sort_original=name == "ok")
        print(f"{name}: {len(entries)} entries")
    write_reverse_lookup_dictionary(output_dir, version, reverse_lookup_entries)
    print(f"flypydz: {len(reverse_lookup_entries)} entries")


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        description="Convert upstream Flypy source dictionaries to canonical Rime YAML"
    )
    parser.add_argument("--source-dir", type=Path, required=True)
    parser.add_argument("--output-dir", type=Path, required=True)
    parser.add_argument("--version", required=True)
    return parser.parse_args()


def main() -> None:
    args = parse_args()
    convert(args.source_dir, args.output_dir, args.version)


if __name__ == "__main__":
    main()
