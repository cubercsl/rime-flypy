from collections.abc import Iterator
from pathlib import Path


ROOT = Path(__file__).parent.parent

HEADER = """;fcitx Version 0x03 Table file
键码=abcdefghijklmnopqrstuvwxyz;'
码长=4
构词=^
[组词规则]
e2=p11+p12+p21+p22
e3=p11+p21+p31+p32
a4=p11+p21+p31+n11
[数据]"""


def yaml_entries(path: Path) -> Iterator[tuple[str, str]]:
    in_dictionary = False
    for line_number, raw_line in enumerate(path.read_text(encoding="utf-8").splitlines(), 1):
        if not in_dictionary:
            if raw_line == "...":
                in_dictionary = True
            continue
        if not raw_line or raw_line == "# no comment":
            continue

        fields = raw_line.split("\t")
        if len(fields) < 2 or not fields[0] or not fields[1]:
            raise ValueError(f"{path}:{line_number}: invalid dictionary entry: {raw_line!r}")
        yield fields[1], fields[0]


def main() -> None:
    print(HEADER)
    for code, word in yaml_entries(ROOT / "flypydz.dict.yaml"):
        print(f"^{code[:2]} {word}")

    dictionaries = (
        "flypy.user.top",
        "flypy.fast.symbols",
        "flypy.primary",
        "flypy.secondary",
        "flypy.three",
        "flypy.web",
        "flypy.emoji",
        "flypy.symbols",
        "flypy.wechat",
        "flypy.primary.short.word",
        "flypy.whimsicality",
        "flypy.user",
    )
    for dictionary in dictionaries:
        for code, word in yaml_entries(ROOT / "flypy" / f"{dictionary}.dict.yaml"):
            print(f"{code} {word}")


if __name__ == "__main__":
    main()
